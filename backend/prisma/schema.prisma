generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wish {
  id          String     @id @default(cuid())
  country     String?
  code        String     @unique
  type        String
  sender      String
  receiver    String?
  message     String
  event       String
  eventLabel  String?
  eventEmoji  String?
  songTitle   String?
  songArtist  String?
  songUrl     String?
  songYtId    String?
  background  String?
  pin         String?
  expiresAt   DateTime?
  views       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  gift        Gift?
  reactions   Reaction[]
  replies     Reply[]

  @@index([code])
  @@index([type])
  @@index([createdAt])
}

model Gift {
  id            String   @id @default(cuid())
  wishId        String   @unique
  message       String?
  mediaUrl      String?
  mediaType     String?
  publicId      String?
  audioUrl      String?
  audioPublicId String?
  createdAt     DateTime @default(now())
  wish          Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)
}

model Reaction {
  id        String   @id @default(cuid())
  wishId    String
  emoji     String
  createdAt DateTime @default(now())
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)

  @@index([wishId])
}

model Reply {
  id        String   @id @default(cuid())
  wishId    String
  name      String
  message   String
  createdAt DateTime @default(now())
  wish      Wish     @relation(fields: [wishId], references: [id], onDelete: Cascade)

  @@index([wishId])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  type      String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}